# =============================================================================
# S&A Recruitment platform - environment
#
# Copy to .env.local. With EVERYTHING blank the app still runs end to end in
# demo mode: sample jobs, default CMS content, a browsable console, simulated
# checkout. Nothing is saved and nothing is charged.
#
# Variables starting NEXT_PUBLIC_ are sent to the browser. Never put a secret in one.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Public origin, used in the sitemap, robots.txt and emails.
SITE_ORIGIN=https://recruitment.smithandadams.com
# Search engines are blocked until this is "true". Turn on when payments work.
ALLOW_INDEXING=

# --- Supabase (database, auth, storage) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security; used after a permission check.
SUPABASE_SERVICE_ROLE_KEY=

# Stable salt for phone/passport hashes and unsubscribe tokens. Set once, never
# rotate without a migration: rotating it orphans every existing hash.
IDENTITY_HASH_SALT=

NEXT_PUBLIC_COHORT_ID=cohort-01

# --- Payments -----------------------------------------------------------------
# Which rail collects the assessment fee from candidates.
#
#   eximpe    RECOMMENDED for a UAE company charging Indian candidates.
#             RBI PA-CB import authorisation: collects INR by UPI, RuPay and
#             Indian net banking and settles abroad. No Indian entity needed.
#   cashfree  Same model (PA-CB). Second option behind the same interface.
#   razorpay  Domestic Indian rail. Cheapest, but needs an Indian company.
#   stripe    Cards only for Indian candidates (no UPI on a UAE account).
#   viva      European acquirer, EU/UK-registered merchants only, EUR, no UPI.
#   dodo      Merchant of record (Dodo is the seller).
#
# See docs/payments.md before going live.
PAYMENT_PROVIDER=eximpe

# Currency the candidate is charged in. MUST match the rail:
#   INR for eximpe, cashfree, razorpay  |  EUR for viva  |  either for stripe, dodo
# Checkout refuses to start when they disagree.
NEXT_PUBLIC_CHARGE_CURRENCY=INR

# EximPe (PAYMENT_PROVIDER=eximpe). Sandbox and production keys and hosts are
# not interchangeable. The webhook is signed with the ENCRYPTION key.
EXIMPE_CLIENT_ID=
EXIMPE_CLIENT_SECRET=
EXIMPE_ENCRYPTION_KEY=
# 'sandbox' (default) or 'production'.
EXIMPE_ENV=sandbox
# Only for PSPs collecting on behalf of sub-merchants. Leave empty.
EXIMPE_MERCHANT_ID=

# Cashfree (PAYMENT_PROVIDER=cashfree).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox

# Razorpay (PAYMENT_PROVIDER=razorpay).
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe. Also used for employer invoices in euros regardless of the rail above.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Methods to offer on Stripe, comma separated: card, upi, netbanking.
STRIPE_METHODS=card

# Viva.com (PAYMENT_PROVIDER=viva). EU/UK merchants only.
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
VIVA_WEBHOOK_KEY=
VIVA_ENV=demo

# Dodo Payments (PAYMENT_PROVIDER=dodo).
DODO_API_KEY=
DODO_WEBHOOK_KEY=
DODO_PRODUCT_ID=
DODO_ENV=test

# Demo only: with no payment keys, checkout is simulated. Setting this to
# "true" also marks the candidate paid. Never set it in production.
ALLOW_SIMULATED_PAYMENTS=

# --- Email --------------------------------------------------------------------
# Transactional mail (application updates, reminders). Without a provider the
# app logs what it would have sent and sends nothing.
EMAIL_FROM="S&A Recruitment <no-reply@mail.smithandadams.com>"
RESEND_API_KEY=
# Or Amazon SES:
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# --- Cron ---------------------------------------------------------------------
# Vercel sends this as a bearer token to /api/cron/*.
CRON_SECRET=

# --- AI (CV extraction and rating) -------------------------------------------
ANTHROPIC_API_KEY=
CV_MODEL=claude-opus-5

# --- Added Oct 2026: phases 4-6. Every feature below is off until its keys are set. ---
# Rate limiting (Upstash Redis REST). Fails open if Upstash is unreachable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cloudflare Turnstile on registration. Set both or neither.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server error reporting (Sentry DSN; no SDK needed).
SENTRY_DSN=
# WhatsApp Cloud API. Templates must be approved by Meta first.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Protects /api/cron/job-alerts (Vercel cron sends it as a bearer token).
CRON_SECRET=
# One inbox emailed about each employer vacancy request.
STAFF_ALERT_EMAIL=

# Require staff to pass an authenticator-app code (Supabase TOTP) before using the console. Enable once every staff member has enrolled at /admin/security.
STAFF_REQUIRE_MFA=
