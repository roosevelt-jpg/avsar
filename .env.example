# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stable salt for phone/passport hashes. Set once and never rotate without a
# migration: rotating it orphans every existing duplicate-detection hash.
IDENTITY_HASH_SALT=

# --- Payments -------------------------------------------------------------
# Which rail collects from candidates: 'cashfree', 'razorpay' or 'stripe'.
#
#   cashfree  cross-border aggregator with an RBI PA-CB licence. Collects INR
#             including UPI and settles to the Dubai entity. The only option
#             here that offers UPI without an Indian company.
#   razorpay  domestic Indian rail. Cheapest, needs an Indian entity.
#   stripe    cards only for Indian candidates, and the rail for employer
#             invoices in euros regardless of this setting.
#
# See docs/payments.md.
PAYMENT_PROVIDER=stripe

# Cashfree, when PAYMENT_PROVIDER=cashfree.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
# 'sandbox' (default) or 'production'.
CASHFREE_ENV=sandbox

# Stripe. Test keys start with sk_test_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Currency the candidate is charged in: INR (default) or EUR.
# The site quotes rupees, so INR is what a candidate expects on their statement.
# Set EUR only if the provider cannot present in rupees from this account; the
# candidate's own bank then converts and adds a fee on top of the quoted price.
CHARGE_CURRENCY=INR

# Methods to offer on Stripe, comma separated: card, upi, netbanking.
# What an account may offer depends on its country and activation, and Stripe's
# support moves, so this is configuration rather than a rule in code. Verify by
# creating a checkout session with the method and seeing whether Stripe accepts
# it. Confirmed accepted on acct_1ULJUeDdQLZiXO6m in test mode: card, upi.
STRIPE_METHODS=card

# Razorpay, only when PAYMENT_PROVIDER=razorpay.
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- AI (CV extraction and rating) ---------------------------------------
# Used by src/lib/cv/*. Without it the CV pipeline returns 503 and the review
# screen shows a worked example.
ANTHROPIC_API_KEY=
# Model for CV work. Recorded on every assessment. See docs/ai-rating.md before
# changing it: at cohort scale this is the largest variable cost in the product.
CV_MODEL=claude-opus-5

# Demo only. With no payment keys, checkout is simulated and nothing is
# charged; this also marks the candidate paid so the assessment is reachable.
# An explicit opt-in, not a consequence of a missing key: otherwise a dropped
# Stripe secret in a real deployment would quietly hand out free assessments.
# Candidates who got in this way are traceable by payments.status = 'simulated'.
ALLOW_SIMULATED_PAYMENTS=

# --- Cohort configuration ---
NEXT_PUBLIC_COHORT_ID=cohort-01

# ---------------------------------------------------------------------- Viva
# European acquirer, on the EU entity. Cannot be used from the Dubai company:
# Viva onboards merchants registered in the EEA or the UK.
#
# Client id and secret come from the merchant portal under API access. The
# webhook key is what their verification GET expects back, and without it
# GET /api/payments/webhook answers 404 and the address will not activate.
#
# VIVA_ENV defaults to demo. Production has to be asked for by name, because
# the wrong way round is real cards hitting the live API by omission.
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
VIVA_WEBHOOK_KEY=
VIVA_ENV=demo

